---
import Layout from '../layouts/Layout.astro';
import { siteConfig } from '../data/siteData';
---

<Layout title="The AUV Ogopogo | Okanagan Marine Robotics">
  <section class="section" style="padding-top: 50px; background: var(--bg-page);">
    <div class="container">
      <div class="section-header">
        <span class="badge">RoboSub Competition Vehicle</span>
        <h1 class="section-title">The AUV — Ogopogo</h1>
        <p class="section-subtitle">Say hello to Ogopogo, our second-generation autonomous underwater vehicle built for RoboSub in California.</p>
      </div>

      <div class="card" style="padding: 0; overflow: hidden; margin-bottom: 50px;">
        <img src={siteConfig.poolTestingImage} alt="Ogopogo submerged in testing pool" style="width: 100%; max-height: 480px; object-fit: cover;" />
        <div style="padding: 36px;">
          <h2 style="font-size: 1.8rem; font-weight: 800; color: var(--navy-deep); margin-bottom: 12px; text-transform: uppercase;">
            Next-Generation Subsea Autonomy
          </h2>
          <p style="color: var(--text-body); font-size: 1.1rem; line-height: 1.8; margin-bottom: 24px;">
            Ogopogo is a true team effort that will continue to evolve moving toward RoboSub 2026. Each improvement builds on what we've learned from previous challenges, testing sessions at the Kelowna Family YMCA, and judge feedback in California.
          </p>
          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 18px; padding-top: 20px; border-top: 1px solid var(--border-color);">
            <div>
              <div style="color: var(--ocean-blue); font-weight: 800; font-family: var(--font-heading); font-size: 1.4rem;">8 Thrusters</div>
              <div style="color: var(--text-muted); font-size: 0.9rem;">6-DOF Full Holonomic Control</div>
            </div>
            <div>
              <div style="color: var(--ocean-blue); font-weight: 800; font-family: var(--font-heading); font-size: 1.4rem;">STM32F7 MCU</div>
              <div style="color: var(--text-muted); font-size: 0.9rem;">Custom Embedded Electronics</div>
            </div>
            <div>
              <div style="color: var(--ocean-blue); font-weight: 800; font-family: var(--font-heading); font-size: 1.4rem;">ROS2 Middleware</div>
              <div style="color: var(--text-muted); font-size: 0.9rem;">Humble Robotics Architecture</div>
            </div>
            <div>
              <div style="color: var(--ocean-blue); font-weight: 800; font-family: var(--font-heading); font-size: 1.4rem;">YOLOv8 Vision</div>
              <div style="color: var(--text-muted); font-size: 0.9rem;">Real-Time Subsea Perception</div>
            </div>
          </div>
        </div>
      </div>

      <!-- Subsystems Deep Dive Cards -->
      <h2 style="font-size: 2rem; font-weight: 800; color: var(--navy-deep); margin-bottom: 28px; text-align: center; text-transform: uppercase;">
        Explore The Subsystems
      </h2>
      <div class="card-grid">
        <div class="card">
          <span class="badge" style="width: fit-content; margin-bottom: 12px;">Mechanical</span>
          <h3 style="font-size: 1.6rem; font-weight: 800; color: var(--navy-deep); margin-bottom: 10px; text-transform: uppercase;">Mechanical Engineering</h3>
          <p style="color: var(--text-body); margin-bottom: 24px; line-height: 1.6;">
            Modular aluminum chassis, waterproof acrylic pressure hull, custom modular battery enclosure, internal electronics sliding tray, pneumatic torpedo and dropper actuators.
          </p>
          <a href="/auv-mechanical" class="btn btn-primary" style="margin-top: auto;">View Mechanical</a>
        </div>
        <div class="card">
          <span class="badge" style="width: fit-content; margin-bottom: 12px;">Electrical</span>
          <h3 style="font-size: 1.6rem; font-weight: 800; color: var(--navy-deep); margin-bottom: 10px; text-transform: uppercase;">Electrical Engineering</h3>
          <p style="color: var(--text-body); margin-bottom: 24px; line-height: 1.6;">
            Redesigned STM32F7 standalone MCU, dedicated Actuator Board, heavy-duty Power Distribution Board (PDB), magnetic kill switch, custom Battery Management System (BMS), and subsea acoustic hydrophones.
          </p>
          <a href="/auv-electrical" class="btn btn-primary" style="margin-top: auto;">View Electrical</a>
        </div>
        <div class="card">
          <span class="badge" style="width: fit-content; margin-bottom: 12px;">Software</span>
          <h3 style="font-size: 1.6rem; font-weight: 800; color: var(--navy-deep); margin-bottom: 10px; text-transform: uppercase;">Software &amp; Autonomy</h3>
          <p style="color: var(--text-body); margin-bottom: 24px; line-height: 1.6;">
            Layered 5-tier control hierarchy, ROS2 nodes, automated state machine mission planner, OpenCV &amp; YOLOv8 perception, acoustic time-difference-of-arrival (TDoA) localization, and Stonefish simulation.
          </p>
          <a href="/auv-software" class="btn btn-primary" style="margin-top: auto;">View Software</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
