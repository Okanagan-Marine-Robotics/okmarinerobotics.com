---
import SiteLayout from '../layouts/SiteLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import { getPage } from '../lib/content';

const page = await getPage('robosub-2025');
const { copy, links } = page;
---

<SiteLayout page={page}>
  <section class="section" style="padding-top: 50px; background: var(--bg-page);">
    <div class="container">
      <PageIntro intro={page.intro} />

      <div class="stat-band">
        <div class="stats-grid">
          <div class="stat-card">
            <div class="stat-value">{copy.value11th}</div>
            <div class="stat-label">{copy.internationallyOutOf58Teams}</div>
          </div>
          <div class="stat-card">
            <div class="stat-value">{copy.value2nd}</div>
            <div class="stat-label">{copy.rankedTeamInCanada}</div>
          </div>
          <div class="stat-card">
            <div class="stat-value">{copy.value4th}</div>
            <div class="stat-label">{copy.placeTechnicalDesignPaper}</div>
          </div>
          <div class="stat-card">
            <div class="stat-value">{copy.value4th}</div>
            <div class="stat-label">{copy.placeTeamDemonstrationVideo}</div>
          </div>
        </div>
      </div>

      <div class="card" style="padding: 40px; margin-bottom: 50px;">
        <div style="border-radius: var(--radius-md); overflow: hidden; margin-bottom: 28px; background: #E2E8F0; border: 1px solid var(--border-color);">
          <img src={links.heroImage} alt={copy.okanaganMarineRoboticsAtRobosubAlt} style="width: 100%; max-height: 520px; object-fit: cover;" />
        </div>
        <h2 style="font-size: 1.8rem; margin-bottom: 14px;">
          {copy.doublingOurFootprintInCalifornia}
        </h2>
        <p style="color: var(--text-body); font-size: 1.1rem; line-height: 1.8; margin-bottom: 24px;">
          {copy.thisYearOurTeamDoubled} <strong>{copy.ogopogo}</strong> {copy.backToIrvineCaliforniaFor}
        </p>
        <div style="display: flex; gap: 14px; flex-wrap: wrap;">
          <a href={links.teamVideo} target="_blank" rel="noopener" class="btn btn-primary">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="5 3 19 12 5 21 5 3"/></svg>
            {copy.watch4thPlaceTeamVideo}
          </a>
          <a href={links.robosub2025TechnicalPaper} target="_blank" class="btn btn-secondary">
            {copy.readTechnicalPaperPdf}
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
          </a>
          <a href={links.leaderboard} target="_blank" rel="noopener" class="btn btn-secondary">
            {copy.officialLeaderboardStandings}
          </a>
        </div>
      </div>
    </div>
  </section>
</SiteLayout>
