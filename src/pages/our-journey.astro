---
import SiteLayout from '../layouts/SiteLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import { getPage, getOrdered } from '../lib/content';

const page = await getPage('our-journey');
const { copy, links } = page;
const journeyTimeline = await getOrdered('milestones');
---

<SiteLayout page={page}>
  <section class="section" style="padding-top: 50px; background: var(--bg-page);">
    <div class="container">
      <PageIntro intro={page.intro} />

      <div style="max-width: 820px; margin: 0 auto 50px; text-align: center; color: var(--text-body); font-size: 1.15rem; line-height: 1.8;">
        <p>
          {copy.soWhereDidItAll}
        </p>
      </div>

      <div class="timeline">
        {journeyTimeline.map((item) => (
          <div class="timeline-item">
            <div class="timeline-dot"></div>
            <div class="timeline-year">{item.year}</div>
            <h3 class="timeline-title">{item.title}</h3>
            <p class="timeline-desc">{item.desc}</p>
          </div>
        ))}
      </div>

      <div class="card" style="margin-top: 50px; text-align: center; max-width: 820px; margin-left: auto; margin-right: auto;">
        <h2 style="font-size: 1.8rem; margin-bottom: 12px;">
          {copy.bePartOfOurNext}
        </h2>
        <p style="color: var(--text-body); max-width: 650px; margin: 0 auto 24px; font-size: 1.05rem;">
          {copy.whetherYouWantToBuild}
        </p>
        <div style="display: flex; justify-content: center; gap: 16px; flex-wrap: wrap;">
          <a href={links.ourTeam} class="btn btn-primary">{copy.meetOurMembers}</a>
          <a href={links.sponsors} class="btn btn-secondary">{copy.sponsorOurJourney}</a>
        </div>
      </div>
    </div>
  </section>
</SiteLayout>
