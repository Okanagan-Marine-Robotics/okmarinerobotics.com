---
import SiteLayout from '../layouts/SiteLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import { getPage } from '../lib/content';

const page = await getPage('robosub-2024');
const { copy, links } = page;
---

<SiteLayout page={page}>
  <section class="section" style="padding-top: 50px; background: var(--bg-page);">
    <div class="container">
      <PageIntro intro={page.intro} />

      <div style="background: var(--navy-section); border-radius: var(--radius-md); padding: 40px 24px; color: #FFFFFF; margin-bottom: 50px; box-shadow: var(--shadow-sm);">
        <div class="stats-grid">
          <div class="stat-card">
            <div class="stat-value">{copy.value15th}</div>
            <div class="stat-label">{copy.internationallyOutOf50Teams}</div>
          </div>
          <div class="stat-card">
            <div class="stat-value">{copy.value3rd}</div>
            <div class="stat-label">{copy.rankedTeamInCanada}</div>
          </div>
          <div class="stat-card">
            <div class="stat-value">{copy.semifinals}</div>
            <div class="stat-label">{copy.advancedOnRookieDebut}</div>
          </div>
          <div class="stat-card">
            <div class="stat-value">{copy.value23Hours}</div>
            <div class="stat-label">{copy.roadTripDriveToCalifornia}</div>
          </div>
        </div>
      </div>

      <div class="card" style="padding: 40px; margin-bottom: 50px;">
        <div style="border-radius: var(--radius-md); overflow: hidden; margin-bottom: 28px; background: #E2E8F0; border: 1px solid var(--border-color);">
          <img src={links.heroImage} alt={copy.okanaganMarineRoboticsAtRobosubAlt} style="width: 100%; max-height: 520px; object-fit: cover;" />
        </div>
        <h2 style="font-size: 2rem; font-weight: 800; color: var(--navy-deep); margin-bottom: 14px; text-transform: uppercase;">
          {copy.fromKelownaToCalifornia}
        </h2>
        <p style="color: var(--text-body); font-size: 1.1rem; line-height: 1.8; margin-bottom: 20px;">
          {copy.afterMonthsOfIntensePlanning} <strong>{copy.cascade}</strong>.
        </p>
        <p style="color: var(--text-body); font-size: 1.05rem; line-height: 1.8; margin-bottom: 28px;">
          {copy.cascadeSuccessfullyPassedInWater}
        </p>
        <div style="display: flex; gap: 14px; flex-wrap: wrap;">
          <a href={links.robosub2024TechnicalPaper} target="_blank" class="btn btn-primary">
            {copy.read2024TechnicalPaperPdf}
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
          </a>
          <a href={links.robosub2025} class="btn btn-secondary">
            {copy.seeOur2025FollowUp}
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        </div>
      </div>
    </div>
  </section>
</SiteLayout>
