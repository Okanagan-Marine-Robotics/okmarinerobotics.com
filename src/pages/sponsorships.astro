---
import SiteLayout from '../layouts/SiteLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import { getPage, getOrdered, getSite } from '../lib/content';

const page = await getPage('sponsorships', 'sponsorships');
const { copy, links, details } = page;
const { tiers } = details;
const sponsors = await getOrdered('sponsors');
const siteConfig = await getSite();
---

<SiteLayout page={page}>
  <section class="section">
    <div class="container">
      <PageIntro intro={page.intro} />

      <div class="actions sponsorship-actions">
        <a href={links.sponsorshipPackage} target="_blank" rel="noopener" class="btn btn-primary">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3"/></svg>
          {copy.downloadSponsorshipPackagePdf}
        </a>
        <a href={siteConfig.donations.corporate} target="_blank" rel="noopener" class="btn btn-secondary">
          {copy.donateDirectlyThroughUbc}
        </a>
      </div>

      <div class="card-grid sponsorship-tiers">
        {tiers.map((t) => (
          <div class="card tier-card">
            <div>
              <h2 class="badge">{t.name}</h2>
              <div class="tier-amount">
                {t.amount}
              </div>
              <ul class="tier-perks">
                {t.perks.map((p) => (
                  <li>{p}</li>
                ))}
              </ul>
            </div>
            <a href={links.contactUs} class="btn btn-secondary" style="width: 100%;">
              {copy.inquireFor} {t.name}
            </a>
          </div>
        ))}
      </div>

      <h2 class="subsection-title">
        {copy.featuredPartnerSpotlights}
      </h2>
      <div class="spotlights">
        {sponsors.filter(sponsor => sponsor.group === 'platinum' || sponsor.group === 'gold').map((s) => (
          <div class="card spotlight-card">
            <div class="sponsor-card">
              <img src={s.logo} alt={s.name} loading="lazy" />
            </div>
            <div>
              <div class="eyebrow">{s.tier}</div>
              <h3>{s.name}</h3>
              <p style="color: var(--text-body); line-height: 1.6;">{s.desc || copy.defaultSponsorDescription}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</SiteLayout>
