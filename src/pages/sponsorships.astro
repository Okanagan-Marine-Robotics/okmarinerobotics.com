---
import Layout from '../layouts/Layout.astro';
import { siteConfig } from '../data/siteData';

const tiers = [
  {
    id: "tier-platinum",
    badge: "Tier 1 • Premier",
    name: "Platinum",
    desc: "Our flagship partnership level offering prominent vehicle branding, prime team uniforms presence, and private live demonstrations.",
    btnClass: "btn-primary"
  },
  {
    id: "tier-gold",
    badge: "Tier 2 • Major",
    name: "Gold",
    desc: "High-visibility competition vehicle presence, team apparel branding, and direct engineering talent recruitment access.",
    btnClass: "btn-secondary"
  },
  {
    id: "tier-silver",
    badge: "Tier 3 • Supporting",
    name: "Silver",
    desc: "Digital recognition across our website, competition presentations, and term engineering progress publications.",
    btnClass: "btn-secondary"
  },
  {
    id: "tier-bronze",
    badge: "Tier 4 • Community",
    name: "Bronze & In-Kind",
    desc: "Essential support through critical hardware, machining, electronics, tooling, or engineering software licensing.",
    btnClass: "btn-secondary"
  }
];
---

<Layout title="Sponsorship Opportunities | Okanagan Marine Robotics">
  <section class="section" style="padding-top: 50px; background: var(--bg-page);">
    <div class="container">
      <!-- Header -->
      <div class="section-header">
        <span class="badge">Partner With Us</span>
        <h1 class="section-title">Sponsorship Opportunities</h1>
        <p class="section-subtitle">Invest in next-generation autonomous subsea technology and connect directly with over 80 driven engineering students at UBC Okanagan.</p>
      </div>

      <!-- Action Bar -->
      <div style="display: flex; justify-content: center; gap: 16px; margin-bottom: 50px; flex-wrap: wrap;">
        <a href="/docs/Sponsorship-Package.pdf" target="_blank" class="btn btn-primary">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3"/></svg>
          Download Sponsorship Package (PDF)
        </a>
        <a href={siteConfig.donations.corporate} target="_blank" rel="noopener" class="btn btn-secondary">
          Donate Directly via UBC Giving
        </a>
      </div>

      <!-- Tiers Section -->
      <div style="text-align: center; margin-bottom: 24px;">
        <h2 style="font-size: 1.8rem; font-weight: 800; color: var(--navy-deep); text-transform: uppercase;">Sponsorship Tiers</h2>
        <p style="color: var(--text-muted); font-size: 1rem; max-width: 650px; margin: 8px auto 0;">
          We offer four distinct sponsorship levels as well as tailored technical partnerships. Detailed deliverables and custom allocations are outlined in our sponsorship package.
        </p>
      </div>

      <div class="sponsorship-tiers-grid">
        {tiers.map((t) => (
          <div class={`tier-card ${t.id}`}>
            <div>
              <span class="tier-card-badge">{t.badge}</span>
              <h3 class="tier-card-title">{t.name}</h3>
              <p class="tier-card-desc">{t.desc}</p>
            </div>
            <a href="/contact-us" class={`btn ${t.btnClass}`} style="width: 100%;">
              Inquire for {t.name}
            </a>
          </div>
        ))}
      </div>

      <!-- Value Pillars -->
      <div style="text-align: center; margin-bottom: 30px; margin-top: 60px;">
        <span class="badge" style="margin-bottom: 10px;">Why Support OKMR</span>
        <h2 style="font-size: 1.8rem; font-weight: 800; color: var(--navy-deep); text-transform: uppercase;">Empowering Future Ocean Engineers</h2>
      </div>

      <div class="why-sponsor-grid">
        <div class="why-sponsor-card">
          <div class="why-sponsor-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          </div>
          <h3 class="why-sponsor-title">Top Engineering Talent</h3>
          <p class="why-sponsor-desc">Direct recruitment access to over 80 passionate students in mechanical, electrical, computer engineering, and computer science with proven hands-on technical skills.</p>
        </div>
        <div class="why-sponsor-card">
          <div class="why-sponsor-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
          </div>
          <h3 class="why-sponsor-title">Global Competition Stage</h3>
          <p class="why-sponsor-desc">Prominently display your brand on our autonomous submarine (AUV) and competition banners at international marine robotics competitions like RoboSub in California.</p>
        </div>
        <div class="why-sponsor-card">
          <div class="why-sponsor-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
          </div>
          <h3 class="why-sponsor-title">Tax-Deductible Contributions</h3>
          <p class="why-sponsor-desc">Donations can be processed through the University of British Columbia's official Giving platform (Project Code: <strong>{siteConfig.donations.code}</strong>), providing official tax receipts.</p>
        </div>
      </div>

      <!-- Custom & In-Kind Banner -->
      <div style="background: linear-gradient(135deg, var(--navy-deep), #0E3054); color: #FFFFFF; padding: 44px 36px; border-radius: var(--radius-lg); margin-bottom: 50px; box-shadow: var(--shadow-md);">
        <div style="max-width: 820px; margin: 0 auto; text-align: center;">
          <span class="badge" style="background: rgba(255,255,255,0.15); color: #FFFFFF; border-color: rgba(255,255,255,0.25); margin-bottom: 14px;">Equipment &amp; Services</span>
          <h2 style="font-size: 1.8rem; font-weight: 800; color: #FFFFFF; text-transform: uppercase; margin-bottom: 14px;">Hardware, Tooling &amp; In-Kind Support</h2>
          <p style="color: #CBD5E1; font-size: 1.05rem; line-height: 1.7; margin-bottom: 28px;">
            Contributions of specialized subsea hardware, CNC machining, PCB manufacturing, raw materials, acoustic sensors, thrusters, and engineering software licenses directly accelerate our build cycles. We welcome technical discussions to integrate your products into our autonomous subsea platform.
          </p>
          <div style="display: flex; justify-content: center; gap: 16px; flex-wrap: wrap;">
            <a href="/contact-us" class="btn btn-primary">Propose In-Kind Sponsorship</a>
            <a href={`mailto:${siteConfig.email}`} class="btn" style="background: rgba(255,255,255,0.12); color: #FFFFFF; border: 1px solid rgba(255,255,255,0.25);">Email Our Team</a>
          </div>
        </div>
      </div>

      <!-- Bottom CTA -->
      <div style="text-align: center; padding: 40px 24px; background: #FFFFFF; border: 1px solid var(--border-color); border-radius: var(--radius-md); box-shadow: var(--shadow-sm);">
        <h3 style="font-size: 1.6rem; font-weight: 800; color: var(--navy-deep); text-transform: uppercase; margin-bottom: 10px;">Ready to Build the Future of Marine Robotics?</h3>
        <p style="color: var(--text-body); max-width: 600px; margin: 0 auto 24px; font-size: 1rem; line-height: 1.6;">
          Download our sponsorship package for complete specifications, or view the organizations currently powering our projects.
        </p>
        <div style="display: flex; justify-content: center; gap: 16px; flex-wrap: wrap;">
          <a href="/docs/Sponsorship-Package.pdf" target="_blank" class="btn btn-primary">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3"/></svg>
            Download Sponsorship Package (PDF)
          </a>
          <a href="/sponsors" class="btn btn-secondary">View Current Sponsors</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
